{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun-types"],
		"verbatimModuleSyntax": true
	},
	"include": ["**/*.ts"]
}
